// GPU-resident full-strand diagnostic backend. Hamilton xyzw, spatial radians.
#include "Linear.hlsli"
RWByteAddressBuffer Display:register(u1);
uint T(Meta m,uint i){return Work.Load(m.pad1+4*i);}
double4 V(uint p,uint i){p+=i*32;return double4(WD(p),WD(p+8),WD(p+16),WD(p+24));}
void SV(uint p,uint i,double4 v){p+=i*32;SD(p,v.x);SD(p+8,v.y);SD(p+16,v.z);SD(p+24,v.w);}
double Dot(double4 a,double4 b){return a.x*b.x+a.y*b.y+a.z*b.z+a.w*b.w;}
double4 Cross(double4 a,double4 b){return double4(a.y*b.z-a.z*b.y,a.z*b.x-a.x*b.z,a.x*b.y-a.y*b.x,0);}
double Norm(double4 a){return DSqrt(Dot(a,a));}
double4 Unit(double4 a){return a*(1.0L/Norm(a));}
double4 Conj(double4 a){return double4(-a.xyz,a.w);}
double4 Mul(double4 a,double4 b){return double4(a.w*b.x+b.w*a.x+a.y*b.z-a.z*b.y,a.w*b.y+b.w*a.y+a.z*b.x-a.x*b.z,a.w*b.z+b.w*a.z+a.x*b.y-a.y*b.x,a.w*b.w-a.x*b.x-a.y*b.y-a.z*b.z);}
double4 Rot(double4 q){double4 v=double4(0,0,1,0),z=double4(q.xyz,0);return v+2.0L*Cross(z,Cross(z,v)+q.w*v);}
double4 Axis(uint i){double4 a=0;a[i]=1;return a;}
bool Finite4(double4 a){return DFinite(a.x)&&DFinite(a.y)&&DFinite(a.z)&&DFinite(a.w);}
// Cody-Waite reduction, binary64 Taylor on [-pi/4,pi/4]. Unsupported angles fail.
bool SinCos64(double x,out double sn,out double cs){sn=cs=0;if(!DFinite(x)||abs(x)>1048576.0L)return false;int k=int(x*0.63661977236758134308L+(x>=0?0.5L:-0.5L));double r=(x-double(k)*1.57079632673412561417L)-double(k)*6.07710050650619224932e-11L;double z=r*r;double a=r,b=1,st=a,ct=b;[unroll]for(uint j=1;j<=9;j++){a=a*(-z)/double((2*j)*(2*j+1));b=b*(-z)/double((2*j-1)*(2*j));st=st+a;ct=ct+b;}uint quadrant=uint(k)&3;sn=quadrant==0?st:quadrant==1?ct:quadrant==2?-st:-ct;cs=quadrant==0?ct:quadrant==1?-st:quadrant==2?-ct:st;return true;}
void Fault(Meta m,uint reason){Work.Store(m.pad0+4,5);Work.Store(m.pad0+20,reason);}
double Cst(Meta m,uint i){return WD(T(m,22)+8*i);}
uint XM(Meta m,uint v){return Work.Load(T(m,20)+4*v);}
uint QM(Meta m,uint v){return Work.Load(T(m,21)+4*v);}
// Same row order and supported-column order as NativeLS::emitPhysics.
void RowStore(uint p,double r,uint count,uint cols[6],double vals[6]){Work.Store(p,count);SD(p+32,r);for(uint k=0;k<count;k++){Work.Store(p+8+4*k,cols[k]);SD(p+40+8*k,vals[k]);}}
void Physics(Meta m,uint xp,uint qp,bool jac,out double energy){uint N=T(m,0),row=0;double h=Cst(m,0),ss=Cst(m,1),bt=Cst(m,2);energy=0;
 for(uint j=0;j<N;j++){double weight=DSqrt(WD(T(m,5)+8*j))/h;double4 rr=weight*(V(xp,j)-V(T(m,11),j));for(uint a=0;a<3;a++){uint cols[6];double vals[6];uint count=0;if(XM(m,j)!=0xffffffff){cols[0]=XM(m,j)+a;vals[0]=weight;count=1;}if(jac)RowStore(T(m,16)+88*row,rr[a],count,cols,vals);energy=energy+0.5L*rr[a]*rr[a];row++;}}
 for(uint j=0;j<N-1;j++){double len=WD(T(m,4)+8*j),w=DSqrt(ss*len);double4 q=V(qp,j),d=Rot(q),rr=w*((V(xp,j+1)-V(xp,j))/len-d);for(uint a=0;a<3;a++){uint cols[6];double vals[6];uint count=0;if(XM(m,j)!=0xffffffff){cols[count]=XM(m,j)+a;vals[count++]=-w/len;}if(XM(m,j+1)!=0xffffffff){cols[count]=XM(m,j+1)+a;vals[count++]=w/len;}if(QM(m,j)!=0xffffffff)for(uint b=0;b<3;b++){cols[count]=QM(m,j)+b;vals[count++]=-w*Cross(Axis(b),d)[a];}if(jac)RowStore(T(m,16)+88*row,rr[a],count,cols,vals);energy=energy+0.5L*rr[a]*rr[a];row++;}
 if(j+1<N-1){double4 left=q,right=V(qp,j+1),rest=V(T(m,3),j),rel=Mul(Conj(left),right);double pole=Dot(rel,rest)>=0?1.0L:-1.0L;double4 r=rel-pole*rest;double weight=DSqrt(4.0L*bt/len);for(uint a=0;a<4;a++){uint cols[6];double vals[6];uint count=0;for(uint b=0;b<3;b++){if(QM(m,j)!=0xffffffff){cols[count]=QM(m,j)+b;vals[count++]=weight*Mul(Conj(0.5L*Mul(Axis(b),left)),right)[a];}if(QM(m,j+1)!=0xffffffff){cols[count]=QM(m,j+1)+b;vals[count++]=weight*Mul(Conj(left),0.5L*Mul(Axis(b),right))[a];}}double r0=weight*r[a];if(jac)RowStore(T(m,16)+88*row,r0,count,cols,vals);energy=energy+0.5L*r0*r0;row++;}}
 }
}
double Guess(Meta m,uint xp,uint qp){double e=0,h=Cst(m,0);uint N=T(m,0);for(uint j=0;j<N;j++){double4 dx=V(xp,j)-V(T(m,11),j);e=e+0.5L*(WD(T(m,5)+8*j)/(h*h))*Dot(dx,dx);if(j+1<N){double len=WD(T(m,4)+8*j);double4 c=(V(xp,j+1)-V(xp,j))/len-Rot(V(qp,j));e=e+0.5L*(Cst(m,1)*len)*Dot(c,c);}}return e;}
void Prepare(Meta m){double lambda=WD(m.pad0+40);for(uint r=0;r<T(m,29);r++){uint p=T(m,16)+88*r,o=m.rowOffset+88*r,count=Work.Load(p);Work.Store(o,count);SD(o+32,-WD(p+32));for(uint k=0;k<count;k++){uint j=Work.Load(p+8+4*k);Work.Store(o+8+4*k,j);SD(o+40+8*k,WD(p+40+8*k)/WD(m.scaleOffset+8*j));}}
 for(uint j=0;j<m.n;j++){uint p=m.rowOffset+88*(T(m,29)+j);Work.Store(p,1);Work.Store(p+8,j);SD(p+32,0);SD(p+40,DSqrt(lambda));SD(m.rhsOffset+8*j,-WD(T(m,19)+8*j)/WD(m.scaleOffset+8*j));}
 for(uint i=0;i<m.blocks;i++){uint2 block=Block(m,i),prev=i?Block(m,i-1):uint2(0,0);for(uint a=0;a<6;a++)for(uint b=0;b<6;b++){double v=0,l=0;if(a<block.x&&b<block.x)v=WD(T(m,17)+i*288+(a*6+b)*8)/(WD(m.scaleOffset+8*(block.y+a))*WD(m.scaleOffset+8*(block.y+b)))+(a==b?lambda:0.0L);if(a<block.x&&b<prev.x)l=WD(T(m,18)+i*288+(a*6+b)*8)/(WD(m.scaleOffset+8*(block.y+a))*WD(m.scaleOffset+8*(prev.y+b)));SD(m.diagOffset+i*288+(a*6+b)*8,v);SD(m.lowerOffset+i*288+(a*6+b)*8,l);}}
 Work.Store(m.pad0+4,2);
}
void Assemble(Meta m){double e;Physics(m,T(m,12),T(m,13),true,e);if(!DFinite(e)){Fault(m,1);return;}SD(m.pad0+32,e);for(uint j=0;j<m.n;j++)SD(T(m,19)+8*j,0);for(uint j=0;j<m.blocks*36;j++){SD(T(m,17)+8*j,0);SD(T(m,18)+8*j,0);}
 for(uint r=0;r<T(m,29);r++){uint p=T(m,16)+88*r,count=Work.Load(p);for(uint j=0;j<count;j++){uint a=Work.Load(p+8+4*j);uint4 am=Work.Load4(m.mapOffset+16*a);double ja=WD(p+40+8*j);SD(T(m,19)+8*a,WD(T(m,19)+8*a)+ja*WD(p+32));for(uint k=0;k<count;k++){uint b=Work.Load(p+8+4*k);uint4 bm=Work.Load4(m.mapOffset+16*b);double value=ja*WD(p+40+8*k);if(am.x==bm.x||am.x==bm.x+1){uint dest=(am.x==bm.x?T(m,17):T(m,18))+am.x*288+(am.y*6+bm.y)*8;SD(dest,WD(dest)+value);}else if(bm.x!=am.x+1&&value!=0){Fault(m,2);return;}}}}
 for(uint j=0;j<m.n;j++){uint4 map=Work.Load4(m.mapOffset+16*j);SD(m.scaleOffset+8*j,DSqrt(max(1e-30L,WD(T(m,17)+map.x*288+(map.y*6+map.y)*8))));}
 double pc=0,qr=0,sp=0;uint N=T(m,0);for(uint j=0;j<N;j++){if(XM(m,j)!=0xffffffff){uint a=XM(m,j);double4 g=double4(WD(T(m,19)+8*a),WD(T(m,19)+8*(a+1)),WD(T(m,19)+8*(a+2)),0);double diag=WD(T(m,5)+8*j)/(Cst(m,0)*Cst(m,0));if(j)diag+=Cst(m,1)/WD(T(m,4)+8*(j-1));if(j+1<N)diag+=Cst(m,1)/WD(T(m,4)+8*j);pc=max(pc,Norm(g)/diag);}
 if(j+1<N&&QM(m,j)!=0xffffffff){double4 q=V(T(m,13),j),v=(-2.0L*Cst(m,1))*(V(T(m,12),j+1)-V(T(m,12),j)),b=0;if(j){double4 rest=V(T(m,3),j-1),left=V(T(m,13),j-1);b=b+(4.0L*Cst(m,2)/WD(T(m,4)+8*(j-1))*(Dot(Mul(Conj(left),q),rest)>=0?1.0L:-1.0L))*Mul(left,rest);}if(j+2<N){double4 rest=V(T(m,3),j),right=V(T(m,13),j+1);b=b+(4.0L*Cst(m,2)/WD(T(m,4)+8*j)*(Dot(Mul(Conj(q),right),rest)>=0?1.0L:-1.0L))*Mul(right,Conj(rest));}q=Unit(q);double4 sum=Mul(Mul(v,q),double4(0,0,1,0))+b;double lambda=Dot(q,sum),scale=Norm(v)+Norm(b);if(scale!=0){qr=max(qr,Norm(sum-lambda*q)/scale);sp=max(sp,max(0.0L,Norm(v)-lambda)/scale);}}}
 SD(m.pad0+48,pc);SD(m.pad0+56,qr);SD(m.pad0+64,sp);if(pc<1e-11L&&qr<1e-9L&&sp<1e-9L){Work.Store(m.pad0+4,4);return;}if(Work.Load(m.pad0+8)>=1500){Fault(m,3);return;}Work.Store(m.pad0+12,0);Prepare(m);
}
[numthreads(32,1,1)]void Begin(uint3 tid:SV_DispatchThreadID){if(tid.x>=SystemCount)return;Meta m=Metadata(tid.x);if(Work.Load(m.pad0+4)!=0)return;uint N=T(m,0);double h=Cst(m,0);double4 gravity=double4(Cst(m,3),Cst(m,4),Cst(m,5),0);for(uint j=0;j<N;j++){double4 x=V(T(m,6),j),v=V(T(m,8),j);if(Command!=0&&j){double a,b;SinCos64(1.57079632679L*double(j)/double(N-1),a,b);v=v+a*double4(KickX,KickY,KickZ,0);}SV(T(m,9),j,x);SV(T(m,10),j,v);bool pin=j==0&&T(m,27)!=0;double4 y=pin?V(T(m,1),j):x+h*v+(h*h)*gravity;SV(T(m,11),j,y);SV(T(m,12),j,y);SV(T(m,14),j,pin?V(T(m,1),j):x+h*v);if(j+1<N){double4 q=j==0&&T(m,28)!=0?V(T(m,2),j):V(T(m,7),j);SV(T(m,13),j,q);}}
 double full=Guess(m,T(m,12),T(m,13)),other=Guess(m,T(m,14),T(m,13));SD(m.pad0+72,other<full?1.0L:0.0L);if(DFinite(other)&&other<full)for(uint j=0;j<N;j++)SV(T(m,12),j,V(T(m,14),j));for(uint j=0;j+1<N;j++)if(QM(m,j)!=0xffffffff)SV(T(m,13),j,Unit(V(T(m,13),j)));Work.Store(m.pad0+8,0);Work.Store(m.pad0+92,0);Work.Store(m.pad0+28,0);SD(m.pad0+40,1e-8L);if(Command!=0)Work.Store(m.pad0+24,Work.Load(m.pad0+24)+1);Work.Store(m.pad0+4,1);
}
bool Trial(Meta m){uint N=T(m,0),lineTrial=Work.Load(m.pad0+16);double alpha=1.0L/double(1u<<lineTrial);Addresses w=AddressesOf(m);for(uint j=0;j<N;j++){double4 x=V(T(m,12),j);uint a=XM(m,j);if(a!=0xffffffff)for(uint k=0;k<3;k++)x[k]+=alpha*WD(w.u+8*(a+k))/WD(m.scaleOffset+8*(a+k));SV(T(m,14),j,x);if(j+1<N){double4 q=V(T(m,13),j);a=QM(m,j);if(a!=0xffffffff){double4 theta=0;for(uint k=0;k<3;k++)theta[k]=alpha*WD(w.u+8*(a+k))/WD(m.scaleOffset+8*(a+k));double n=Norm(theta);double4 dq;if(n>1e-14L){double sn,cs;if(!SinCos64(n*0.5L,sn,cs)){Fault(m,4);return false;}dq=double4(theta.xyz*(sn/n),cs);}else dq=Unit(double4(theta.xyz*0.5L,1));q=Unit(Mul(dq,q));}if(!Finite4(q)){Fault(m,5);return false;}SV(T(m,15),j,q);}}
 double e;Physics(m,T(m,14),T(m,15),false,e);if(DFinite(e)&&e<WD(m.pad0+32)){for(uint j=0;j<N;j++){SV(T(m,12),j,V(T(m,14),j));if(j+1<N)SV(T(m,13),j,V(T(m,15),j));}SD(m.pad0+40,max(1e-12L,WD(m.pad0+40)*0.2L));Work.Store(m.pad0+8,Work.Load(m.pad0+8)+1);Work.Store(m.pad0+28,Work.Load(m.pad0+28)+1);Work.Store(m.pad0+4,1);return true;}
 lineTrial++;if(lineTrial<16)Work.Store(m.pad0+16,lineTrial);else{uint retry=Work.Load(m.pad0+12)+1;if(retry>=16){Fault(m,6);return false;}Work.Store(m.pad0+12,retry);SD(m.pad0+40,min(1e12L,WD(m.pad0+40)*10.0L));Prepare(m);}return false;
}
[numthreads(32,1,1)]void Advance(uint3 tid:SV_DispatchThreadID){if(tid.x>=SystemCount)return;Meta m=Metadata(tid.x);uint phase=Work.Load(m.pad0+4);if(phase==1||phase==3){uint rounds=Work.Load(m.pad0+92)+1;Work.Store(m.pad0+92,rounds);if(rounds>20000){Fault(m,8);return;}}if(phase==1)Assemble(m);else if(phase==3)Trial(m);}
[numthreads(32,1,1)]void FinishLinear(uint3 tid:SV_DispatchThreadID){if(tid.x>=SystemCount)return;Meta m=Metadata(tid.x);if(Work.Load(m.pad0+4)!=2)return;Addresses a=AddressesOf(m);if(Work.Load(a.status)!=0){Fault(m,100+Work.Load(a.status));return;}Work.Store(m.pad0+16,0);Work.Store(m.pad0+4,3);}
// Whole-batch validation before any completed physical state is modified.
[numthreads(1,1,1)]void Commit(uint3 tid:SV_DispatchThreadID){for(uint i=0;i<SystemCount;i++){Meta m=Metadata(i);if(Work.Load(m.pad0+4)!=4)return;for(uint j=0;j<T(m,0);j++){double4 x=V(T(m,12),j),v=(x-V(T(m,9),j))/Cst(m,0);if(!Finite4(x)||!Finite4(v)){Fault(m,7);return;}}}for(uint i=0;i<SystemCount;i++){Meta m=Metadata(i);uint N=T(m,0);for(uint j=0;j<N;j++){double4 x=V(T(m,12),j),v=j==0&&T(m,27)!=0?double4(0,0,0,0):(x-V(T(m,9),j))/Cst(m,0);SV(T(m,6),j,x);SV(T(m,8),j,v);if(j+1<N)SV(T(m,7),j,V(T(m,13),j));}uint step=Work.Load(m.pad0)+1;Work.Store(m.pad0,step);SV(T(m,24),step%128,V(T(m,6),N-1));Work.Store(m.pad0+4,0);}}
void VertexOut(uint idx,double4 p,float3 color){uint dst=idx*24;Display.Store3(dst,asuint(float3(p.xyz)));Display.Store3(dst+12,asuint(color));}
[numthreads(32,1,1)]void Export(uint3 tid:SV_DispatchThreadID){if(tid.x>=SystemCount)return;Meta m=Metadata(tid.x);uint N=T(m,0),start=T(m,23),o=start;double maximum=0;for(uint k=0;k<N;k++)maximum=max(maximum,Norm(V(T(m,6),k)-V(T(m,1),k)));double4 tip=V(T(m,6),N-1);SD(m.pad0+96,tip.x);SD(m.pad0+104,tip.y);SD(m.pad0+112,tip.z);SD(m.pad0+120,maximum);for(uint j=0;j<N-1;j++){VertexOut(o++,V(T(m,6),j),float3(.05,1,1));VertexOut(o++,V(T(m,6),j+1),float3(.05,1,1));}for(uint j=0;j<N-1;j++){double4 a=V(T(m,1),j),b=DrawGhost?V(T(m,1),j+1):a;VertexOut(o++,a,float3(.25,.28,.45));VertexOut(o++,b,float3(.25,.28,.45));}uint step=Work.Load(m.pad0),count=min(step,127u);for(uint j=0;j<127;j++){double4 a=V(T(m,6),N-1),b=a;if(DrawTraces!=0&&j<count){a=V(T(m,24),(step-count+j)%128);b=V(T(m,24),(step-count+j+1)%128);}VertexOut(o++,a,float3(1,.5,.05));VertexOut(o++,b,float3(1,.5,.05));}}
// Explicit diagnostic only. Outputs FP64 trig, sqrt and retraction probes.
[numthreads(32,1,1)]void MathProbe(uint3 tid:SV_DispatchThreadID){uint j=tid.x;if(j>=32)return;double angle=double(int(j)-16)*0.125L;if(j==0)angle=1e-16L;if(j==1)angle=1048575.0L;if(j==2)angle=-1048575.0L;double s,c;bool ok=SinCos64(angle,s,c);double4 q=Unit(double4(s,0,0,c));double values[8]={angle,s,c,DSqrt(double(j+1)*1e-8L),q.x,q.w,ok?1.0L:0.0L,0};for(uint k=0;k<8;k++){uint lo,hi;asuint(values[k],lo,hi);Display.Store2(j*64+k*8,uint2(lo,hi));}}
